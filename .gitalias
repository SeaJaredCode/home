[alias]
    a = add -A
    u = add -u
    b = branch
    bc = branch --contains
    bC = branch -r --contains
    bcr = branch -r --contains
    f = fetch
    fp = fetch --prune
    fa = fetch --all --prune
    m = merge
    s = status
    st = status
    ci = commit
    cin = commit --no-edit
    un = "!f() {\
            git u; \
            git can; \
        };f"
    unp = "!f() { \
            git un; \
            git yolo; \
        }; f"
    ca = commit --amend
    can = commit --amend --no-edit
    co = checkout
    cm = checkout -m
    cp = cherry-pick
    cpa = cherry-pick --abort
    cpc = cherry-pick --continue
    cb = "!f() { \
        if git rev-parse --verify origin/main >/dev/null 2>&1; then \
            git checkout -b \"$1\" origin/main; \
        else \
            git checkout -b \"$1\" origin/master; \
        fi \
    }; f"
    cbr = "!f() {\
            gerrit_create_branch origin $1 master;\
        };f"
    cbs = "!f() {\
            git cbr $1;\
            git cb $1;\
        };f"
    cu = "!f() {\
            git fetch; \
            git checkout -B $1 origin/$1;\
        };f"
    l = !do_git_log $@
    ls = log --oneline
    lf = log --name-status
    gdiff = difftool -g -d
    gwdiff = difftool --tool=winmerge -d
    wdiff = difftool --tool=winmerge
    yolo = push --force-with-lease
    rpm = rebase --preserve-merges
    rev = "!f() {\
            gerrit_push_review $1; \
        };f"
    alias = "!f() {\
            if [ -z $1 ] || [ -z $2 ]; \
            then \
                git config --get-regexp alias; \
                echo '\nTo make alias: git alias <alias> <command>'; \
            else \
                git config --global alias.$1 $2; \
            fi; \
        };f"
    l = !do_git_log
    ri = "!f() {\
            if [ -z "$1" ]; then \
                if git rev-parse --verify origin/main >/dev/null 2>&1; then \
                    git rebase -i origin/main; \
                else \
                    git rebase -i origin/master; \
                fi \
            else \
                git rebase -i "$@"; \
            fi; \
        };f"
    rc = rebase --continue
    ra = rebase --abort
    mc = merge --continue
    pex = "!f() {\
            if [ -z "$1" ]; then \
                echo "Usage: pex NUM_COMMITS"; \
                echo -"     Where NUM_COMMITS is how many commits back from head"; \
                return 1; \
            fi; \
            rb=$(git for-each-ref --format='%(upstream:short)' "$(git symbolic-ref -q HEAD)" | cut -d "/" -f 2-); \
            git push origin HEAD~$1:$rb; \
        };f"
    mt = mergetool
    why = check-ignore --verbose --non-matching
    recent = "!r() {\
            refbranch=$1; \
            count=$2; \
            head_branch=$(if git rev-parse --verify origin/main >/dev/null 2>&1; then echo "main"; else echo "master"; fi); \
            git for-each-ref --sort=-committerdate refs/heads \
                --format='%(refname:short)|%(HEAD)%(color:yellow)%(refname:short)|%(color:bold green)%(committerdate:relative)|%(color:blue)%(subject)|%(color:magenta)%(authorname)%(color:reset)' \
                --color=always --count=${count:-20} | \
                while read line; do \
                    branch=$(echo \"$line\" | awk 'BEGIN { FS = \"|\" }; { print $1 }' | tr -d '*'); \
                    ahead=$(git rev-list --count \"${refbranch:-origin/$head_branch}..${branch}\"); \
                    behind=$(git rev-list --count \"${branch}..${refbranch:-origin/$head_branch}\"); \
                    colorline=$(echo \"$line\" | sed 's/^[^|]*|//'); echo \"$ahead|$behind|$colorline\" | awk -F'|' -vOFS='|' '{$5=substr($5,1,70)}1' ; \
                done | \
                ( echo \"ahead|behind||branch|lastcommit|message|author\\n\" && cat) | \
                column -ts'|'; \
        };r"
    history = "!r() {\
        index=$((${1:-10}+1)); \
        git reflog | \
        grep \"checkout: moving from\" | \
        cut -d ' ' -f 8 | \
        sed \"${index}q\" | \
        nl -v0 | \
        sed '1s/ 0\t/ -\t/'; \
        };r"
    back = "!r() {\
        index=$((${1:-1}+1)); \
        branch=$(git reflog | \
        grep \"checkout: moving from\" | \
        cut -d ' ' -f 8 | \
        sed \"${index:-1}q;d\"); \
        git checkout $branch; \
        };r"
    prev = "!r() {\
        branch=$(git reflog | \
        grep \"checkout: moving from\" | \
        cut -d ' ' -f 8 | \
        sed '2q;d'); \
        git checkout $branch; \
        };r"
    yd = "!r() {\
        ydiff "$@"; \
        };r"
    yds = "!r() {\
        ydiff -s -w 0 "$@"; \
    };r"
    showy = "!r() {\
        ydiff -ls -w 0 "$@"; \
    };r"
    canu = "!git u && git can"
    canup = "!git u && git can && git yolo"

